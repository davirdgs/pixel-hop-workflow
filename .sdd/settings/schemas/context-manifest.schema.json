{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.local/schemas/context-manifest.schema.json",
  "title": "SDD Context Manifest v1",
  "type": "object",
  "required": ["schema_version", "updated_at", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "hash", "updated_at", "status", "section_index", "summary", "dependencies"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "updated_at": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "minLength": 1 },
          "section_index": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "last_review_context_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "ledger_cursor": { "type": ["integer", "null"], "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
