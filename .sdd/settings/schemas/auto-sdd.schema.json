{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.local/schemas/auto-sdd.schema.json",
  "title": "Auto-SDD Orchestration State v1",
  "type": "object",
  "required": ["schema_version", "feature", "mode", "started_at", "updated_at", "initiated_by", "stage", "artifact_hashes", "reviews", "correction_cycles", "implementation_gate", "plan_hash", "waves", "final_validation", "history"],
  "properties": {
    "schema_version": { "const": 1 },
    "feature": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "mode": { "const": "auto-sdd" },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "initiated_by": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["requirements", "design", "tasks", "awaiting_implementation_approval", "implementation", "validation", "complete", "blocked", "closed"] },
    "artifact_hashes": {
      "type": "object",
      "required": ["requirements", "design", "tasks"],
      "properties": {
        "requirements": { "$ref": "#/$defs/hashOrNull" },
        "design": { "$ref": "#/$defs/hashOrNull" },
        "tasks": { "$ref": "#/$defs/hashOrNull" }
      },
      "additionalProperties": false
    },
    "correction_cycles": {
      "type": "object",
      "required": ["requirements", "design", "tasks", "implementation", "validation"],
      "properties": {
        "requirements": { "type": "integer", "minimum": 0 },
        "design": { "type": "integer", "minimum": 0 },
        "tasks": { "type": "integer", "minimum": 0 },
        "implementation": { "type": "integer", "minimum": 0 },
        "validation": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "token_governance": {
      "type": "object",
      "required": ["soft_budget", "hard_budget", "currency", "input_tokens", "cached_input_tokens", "output_tokens", "estimated_cost", "warn_at_percent", "require_approval_at_percent"],
      "properties": {
        "soft_budget": { "type": ["number", "null"], "minimum": 0 },
        "hard_budget": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost": { "type": "number", "minimum": 0 },
        "warn_at_percent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "require_approval_at_percent": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "model_policy": {
      "type": "object",
      "required": ["strategy", "require_explicit_model", "on_no_adequate_model", "provider", "catalog", "cataloged_at"],
      "properties": {
        "strategy": { "const": "lowest-adequate" },
        "require_explicit_model": { "const": true },
        "on_no_adequate_model": { "const": "block" },
        "provider": { "type": ["string", "null"] },
        "catalog": {
          "type": "array",
          "items": { "$ref": "#/$defs/modelCatalogEntry" }
        },
        "cataloged_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "validation_policy": {
      "type": "object",
      "required": ["profile", "selected_at", "rationale", "risk_factors", "artifact_review_mode", "wave_validation_mode", "final_validation_mode"],
      "properties": {
        "profile": { "enum": ["pending", "lean", "standard", "critical"] },
        "selected_at": { "type": ["string", "null"], "format": "date-time" },
        "rationale": { "type": ["string", "null"] },
        "risk_factors": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationRiskFactor" },
          "uniqueItems": true
        },
        "artifact_review_mode": { "enum": ["pending", "hash-reuse-focused", "sequential"] },
        "wave_validation_mode": { "enum": ["pending", "batched-independent", "dependency-boundary", "per-wave"] },
        "final_validation_mode": { "enum": ["pending", "reuse-single-wave", "incremental", "full"] }
      },
      "additionalProperties": false
    },
    "validation_policy_hash": { "$ref": "#/$defs/hashOrNull" },
    "reviews": {
      "type": "object",
      "required": ["requirements", "design", "tasks"],
      "properties": {
        "requirements": { "$ref": "#/$defs/review" },
        "design": { "$ref": "#/$defs/review" },
        "tasks": { "$ref": "#/$defs/review" }
      },
      "additionalProperties": false
    },
    "implementation_gate": {
      "type": "object",
      "required": ["status", "approved_by", "approved_at", "spec_revision", "requirements_hash", "design_hash", "tasks_hash", "plan_hash"],
      "properties": {
        "status": { "enum": ["pending", "approved", "revoked"] },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "spec_revision": { "type": ["integer", "null"], "minimum": 1 },
        "requirements_hash": { "$ref": "#/$defs/hashOrNull" },
        "design_hash": { "$ref": "#/$defs/hashOrNull" },
        "tasks_hash": { "$ref": "#/$defs/hashOrNull" },
        "plan_hash": { "$ref": "#/$defs/hashOrNull" },
        "validation_policy_hash": { "$ref": "#/$defs/hashOrNull" }
      },
      "additionalProperties": false
    },
    "plan_hash": { "$ref": "#/$defs/hashOrNull" },
    "waves": {
      "type": "array",
      "items": { "$ref": "#/$defs/wave" }
    },
    "final_validation": {
      "type": "object",
      "required": ["status", "agent", "attempt"],
      "properties": {
        "status": { "enum": ["pending", "passed", "failed", "partial"] },
        "agent": { "type": ["string", "null"] },
        "attempt": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["pending", "reuse-single-wave", "incremental", "full"] },
        "reused_wave": {
          "type": ["string", "null"],
          "pattern": "^wave-[1-9][0-9]*$"
        },
        "scope_summary": { "type": ["string", "null"] },
        "model_requirement": { "$ref": "#/$defs/modelRequirement" },
        "model_assignment": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/modelAssignment" }
          ]
        }
      },
      "additionalProperties": false
    },
    "recoveries": {
      "type": "array",
      "items": { "$ref": "#/$defs/recovery" }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "event"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "event": { "type": "string" },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "hashOrNull": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "validationRiskFactor": {
      "enum": ["localized", "single-wave", "reversible", "known-pattern", "cross-component", "multi-wave", "ambiguous", "architecture", "external-dependency", "cross-platform", "security", "privacy", "auth", "data-migration", "destructive", "commerce", "production", "broad-regression"]
    },
    "modelCatalogEntry": {
      "type": "object",
      "required": ["model", "capability", "cost_rank"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "capability": { "enum": ["routine", "advanced", "frontier"] },
        "cost_rank": { "type": "integer", "minimum": 1 },
        "input_cost_per_million": { "type": ["number", "null"], "minimum": 0 },
        "cached_input_cost_per_million": { "type": ["number", "null"], "minimum": 0 },
        "output_cost_per_million": { "type": ["number", "null"], "minimum": 0 },
        "pricing_effective_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "modelRequirement": {
      "type": "object",
      "required": ["capability", "risk_factors", "rationale"],
      "properties": {
        "capability": { "enum": ["pending", "routine", "advanced", "frontier"] },
        "risk_factors": {
          "type": "array",
          "items": {
            "enum": ["localized", "cross-component", "ambiguous", "architecture", "concurrency", "security", "privacy", "auth", "data-migration", "destructive", "commerce", "production", "broad-regression"]
          },
          "uniqueItems": true
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "modelAssignment": {
      "type": "object",
      "required": ["agent", "role", "model", "capability", "cost_rank", "rationale"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "role": { "enum": ["executor", "fixer", "validator"] },
        "model": { "type": "string", "minLength": 1 },
        "capability": { "enum": ["routine", "advanced", "frontier"] },
        "cost_rank": { "type": "integer", "minimum": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "cached_input_tokens", "output_tokens", "estimated_cost"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "cached_input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "estimated_cost": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "content_hash", "reviewed_at", "reviewer", "attempt"],
      "properties": {
        "status": { "enum": ["pending", "passed", "failed"] },
        "content_hash": { "$ref": "#/$defs/hashOrNull" },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "reviewer": { "type": ["string", "null"] },
        "attempt": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "recoveryClaim": {
      "type": "object",
      "required": ["task", "agent", "attempt"],
      "properties": {
        "task": { "type": "string", "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*)?$" },
        "agent": { "type": "string", "minLength": 1 },
        "attempt": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["at", "actor", "target", "decision", "from_attempt", "to_attempt", "reason", "abandoned_claims"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 },
        "target": {
          "type": "string",
          "pattern": "^(?:wave-[1-9][0-9]*|final-validation)$"
        },
        "decision": { "enum": ["continue", "recover"] },
        "from_attempt": { "type": "integer", "minimum": 0 },
        "to_attempt": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 },
        "abandoned_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryClaim" }
        }
      },
      "additionalProperties": false
    },
    "wave": {
      "type": "object",
      "required": ["id", "task_ids", "depends_on", "status", "attempt", "executor_agents", "validator_agents", "blockers"],
      "properties": {
        "id": { "type": "string", "pattern": "^wave-[1-9][0-9]*$" },
        "task_ids": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*)?$" }, "minItems": 1, "uniqueItems": true },
        "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^wave-[1-9][0-9]*$" }, "uniqueItems": true },
        "validation_batch": {
          "type": ["string", "null"],
          "pattern": "^batch-[1-9][0-9]*$"
        },
        "status": { "enum": ["pending", "in_progress", "failed", "partial", "validated"] },
        "attempt": { "type": "integer", "minimum": 0 },
        "executor_agents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "validator_agents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "model_requirements": {
          "type": "object",
          "required": ["executor", "validator"],
          "properties": {
            "executor": { "$ref": "#/$defs/modelRequirement" },
            "validator": { "$ref": "#/$defs/modelRequirement" }
          },
          "additionalProperties": false
        },
        "model_assignments": {
          "type": "array",
          "items": { "$ref": "#/$defs/modelAssignment" }
        },
        "blockers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
