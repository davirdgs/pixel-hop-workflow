{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.local/schemas/tasks.schema.json",
  "title": "SDD Canonical Task Ledger v1",
  "type": "object",
  "required": ["schema_version", "feature", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "feature": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "optional", "parallel", "requirements", "dependencies", "write_scope", "verification", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*)?$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "in_progress", "blocked", "complete", "cancelled"] },
          "optional": { "type": "boolean" },
          "parallel": { "type": "boolean" },
          "requirements": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$" }, "uniqueItems": true },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "write_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "verification": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
